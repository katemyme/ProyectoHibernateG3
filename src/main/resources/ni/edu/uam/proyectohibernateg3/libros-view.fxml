<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox alignment="TOP_CENTER" prefHeight="500.0" prefWidth="760.0" spacing="12.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ni.edu.uam.proyectohibernateg3.controller.LibreriaController">
    <children>
        <Label text="Registro de Libros">
            <font>
                <Font name="Times New Roman Bold" size="22.0" />
            </font>
        </Label>
        <GridPane hgap="10.0" vgap="8.0">
            <columnConstraints>
                <ColumnConstraints hgrow="NEVER" minWidth="60.0" />
                <ColumnConstraints hgrow="ALWAYS" />
            </columnConstraints>
            <children>
                <Label text="Título:">
                    <font>
                        <Font name="Times New Roman" size="14.0" />
                    </font>
                </Label>
                <Label text="Autor:" GridPane.rowIndex="1">
                    <font>
                        <Font name="Times New Roman" size="14.0" />
                    </font>
                </Label>
                <Label text="Año:" GridPane.rowIndex="2">
                    <font>
                        <Font name="Times New Roman" size="14.0" />
                    </font>
                </Label>
                <Label text="Precio:" GridPane.rowIndex="3">
                    <font>
                        <Font name="Times New Roman" size="14.0" />
                    </font>
                </Label>
                <TextField fx:id="txtTitulo" promptText="Título del Libro" GridPane.columnIndex="1">
                    <font>
                        <Font name="Times New Roman" size="14.0" />
                    </font>
                </TextField>
                <TextField fx:id="txtAutor" promptText="Autor del Libro" GridPane.columnIndex="1" GridPane.rowIndex="1">
                    <font>
                        <Font name="Times New Roman" size="14.0" />
                    </font>
                </TextField>
                <TextField fx:id="txtAnio" promptText="Año de Publicación" GridPane.columnIndex="1" GridPane.rowIndex="2">
                    <font>
                        <Font name="Times New Roman" size="14.0" />
                    </font>
                </TextField>
                <TextField fx:id="txtPrecio" promptText="Precio del Libro" GridPane.columnIndex="1" GridPane.rowIndex="3">
                    <font>
                        <Font name="Times New Roman" size="14.0" />
                    </font>
                </TextField>
            </children>
        </GridPane>
        <HBox alignment="CENTER" spacing="10.0">
            <children>
                <Button fx:id="btnGuardar" mnemonicParsing="false" onAction="#guardarLibro" text="Guardar Libro">
                    <font>
                        <Font name="Times New Roman Bold" size="14.0" />
                    </font>
                </Button>
                <Button fx:id="btnCargar" mnemonicParsing="false" onAction="#cargarLibros" text="Cargar Libros">
                    <font>
                        <Font name="Times New Roman Bold" size="14.0" />
                    </font>
                </Button>
                <Button fx:id="btnModificar" mnemonicParsing="false" onAction="#modificarLibro" text="Modificar Libro">
                    <font>
                        <Font name="Times New Roman Bold" size="14.0" />
                    </font>
                </Button>
                <Button fx:id="btnEliminar" mnemonicParsing="false" onAction="#eliminarLibro" text="Eliminar Libro">
                    <font>
                        <Font name="Times New Roman Bold" size="14.0" />
                    </font>
                </Button>
                <Button fx:id="btnLimpiar" mnemonicParsing="false" onAction="#limpiarCampos" text="Limpiar Campos">
                    <font>
                        <Font name="Times New Roman Bold" size="14.0" />
                    </font>
                </Button>
            </children>
        </HBox>
        <TableView fx:id="tblLibros" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colId" prefWidth="50.0" style="-fx-alignment: CENTER;" text="ID" />
                <TableColumn fx:id="colTitulo" prefWidth="230.0" text="Título" />
                <TableColumn fx:id="colAutor" prefWidth="200.0" text="Autor" />
                <TableColumn fx:id="colAnio" prefWidth="70.0" style="-fx-alignment: CENTER;" text="Año" />
                <TableColumn fx:id="colPrecio" prefWidth="90.0" style="-fx-alignment: CENTER-RIGHT;" text="Precio" />
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
            <placeholder>
                <Label text="No hay libros para mostrar. Presione &quot;Cargar Libros&quot;." />
            </placeholder>
        </TableView>
    </children>
    <padding>
        <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
    </padding>
</VBox>
